{
  "name": "random-quote-machine",
  "homepage": "https://github.com/nahrinoda/random-quote-machine",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "gh-pages": "^5.0.0",
    "nodemon": "^1.19.1",
    "react": "^16.9.0",
    "react-dom": "^16.9.0",
    "react-scripts": "3.0.1",
    "save": "^2.4.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "shell-quote": "$shell-quote",
    "node-forge": "1.4.0",
    "@babel/runtime": "7.26.10",
    "cross-spawn": "6.0.6",
    "micromatch": "4.0.8",
    "braces": "3.0.3",
    "semver": "6.3.1",
    "tough-cookie": "4.1.3",
    "loader-utils": "1.4.2",
    "minimatch": "3.1.4",
    "terser": "4.8.1",
    "nth-check": "2.0.1",
    "sockjs": "0.3.24",
    "yargs-parser": "13.1.2",
    "serialize-javascript": "7.0.5",
    "tmp": "0.2.6",
    "flatted": "3.4.2",
    "qs": "6.15.2",
    "form-data": "2.5.4",
    "ansi-html": "0.0.8",
    "http-proxy-middleware": "2.0.9",
    "webpack-dev-middleware": "5.3.4",
    "got": "11.8.5",
    "node-notifier": "8.0.1",
    "uuid": "11.1.1",
    "react-dev-utils": "11.0.4",
    "immer": "9.0.6"
  },
  "devDependencies": {
    "shell-quote": "^1.8.4"
  }
}
