{
  "name": "random-quote-machine",
  "homepage": "https://github.com/nahrinoda/random-quote-machine",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "gh-pages": "^5.0.0",
    "nodemon": "^1.19.1",
    "react": "^16.9.0",
    "react-dom": "^16.9.0",
    "react-scripts": "3.0.1",
    "save": "^2.4.0"
  },
  "scripts": {
    "start": "react-scripts start",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d build",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": "react-app"
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "shell-quote": "$shell-quote",
    "node-forge": "1.4.0",
    "@babel/runtime": "7.26.10",
    "cross-spawn": "6.0.6",
    "micromatch": "4.0.8",
    "braces": "3.0.3",
    "semver": "6.3.1",
    "tough-cookie": "4.1.3",
    "loader-utils": "1.4.2",
    "minimatch": "3.1.4"
  },
  "devDependencies": {
    "shell-quote": "^1.8.4"
  }
}
